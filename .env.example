# Copy to .env. Every value has a default, so .env is optional.
# These are host-machine URLs; Compose overrides them with container URLs.

# ---- Compose: project name and host ports, so two stacks can run side by side ----
# COMPOSE_PROJECT_NAME=ai-starter
# API_PORT=8000
# QDRANT_PORT=6333
# LANGFUSE_PORT=3000           # change LANGFUSE_HOST below to match
# AGENTCORE_PORT=8080          # change AGENTCORE_URL below to match

# ---- Safety rules: the fixed `emergency` reply for a danger, before any model call ----
# false only for a project with no safety-critical situations, agreed with the client.
# SAFETY_RULES=true

# ---- Seams (principle 3): pick an implementation per dependency ----
# LLM_PROVIDER=ollama          # ollama | bedrock | azure_openai (not built yet: the ai-project-azure skill)
# RETRIEVER=qdrant             # qdrant
# MEMORY=sqlite                # sqlite | in_process | agentcore (Phase 6)
# GUARDRAIL=noop               # noop | bedrock: the Bedrock Guardrail below (docs/guardrail.md)
# GUARDRAIL_ID=                # in AWS_REGION
# GUARDRAIL_VERSION=           # a published version number, never DRAFT
# PROMPT_SOURCE=file           # file | langfuse: edited in Langfuse, the repo files as fallback;
#                              # without the Langfuse keys below, the files are used
# PROMPT_CACHE_SECONDS=60
# PROMPT_LABEL=production      # the Langfuse label served; `staging` to try an edit locally
# PROMPT_TIMEOUT_SECONDS=2     # the wait for Langfuse before using the file
# PROMPT_RETRY_SECONDS=60      # after a failure, the files for this long before trying again

# SQLite memory keeps conversations across API restarts, on this machine only
# and with no expiry. In Docker it lives in the memory-data volume. Old thread
# IDs only verify after a restart if THREAD_ID_SECRET is set.
# MEMORY_PATH=data/memory.sqlite

# ---- LLM: Ollama running natively on the host ----
OLLAMA_BASE_URL=http://localhost:11434
# gpt-oss:20b needs about 16 GB RAM; qwen3:8b is smaller.
OLLAMA_MODEL=gpt-oss:20b
# LLM_TEMPERATURE=0.1

# ---- LLM: Bedrock (LLM_PROVIDER=bedrock) ----
# Any model that serves the Converse API: a model ID or an inference profile ID. Required.
# A `global.` or `us.` profile is processed outside the Region: record a decision first.
# Credentials come from the usual AWS chain (AWS_PROFILE, or AWS_* variables).
# BEDROCK_MODEL_ID=
# BEDROCK_TEMPERATURE=         # unset: the model's default (OpenAI models refuse others)
# AWS_REGION=ap-southeast-2
# AWS_PROFILE=

# ---- LLM: Azure OpenAI (LLM_PROVIDER=azure_openai), once built ----
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# ---- Content and retrieval ----
# Markdown pages with `title` and `url` front matter; the sample in content/ is synthetic.
# CONTENT_DIR=content
# Only source URLs starting with this become links (the client's own site).
# ALLOWED_LINK_PREFIX=https://example.invalid/
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=content
# An embedded index in a folder, used instead of the server when set.
# QDRANT_PATH=data/index
# The index `python -m assistant.publish` publishes, used instead of both when set:
# s3://bucket/prefix in the cloud, or a local folder such as data/store.
# INDEX_STORE=
# Tuning: measure on the client's content with scripts/verify_retrieval.py.
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MAX_PER_PAGE=1
# RETRIEVAL_MIN_SCORE=0.62
# RETRIEVAL_MAX_GAP=0.1

# ---- Where the API runs a turn ----
# in_process (default) answers in the API. agentcore calls the AgentCore entry point: the local
# container (start the `agentcore` profile; Compose sets AGENTCORE_URL for the api container), or
# in AWS the runtime by ARN.
# AGENT_RUNTIME=agentcore
# AGENTCORE_URL=http://localhost:8080
# AGENTCORE_RUNTIME_ARN=
# AGENTCORE_QUALIFIER=DEFAULT

# ---- Thread IDs and abuse limits ----
# Signs server-issued thread IDs. Unset means a random secret per process, so
# IDs stop working on restart, even though SQLite memory keeps the conversations. Set 32+ characters
# for anything shared, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
# THREAD_ID_SECRET=
# MAX_QUESTION_CHARS=2000
# MAX_TURNS_PER_THREAD=30
# RATE_LIMIT_PER_MINUTE=20
# Behind CloudFront only: the header holding the caller's address (otherwise every caller shares one limit).
# CLIENT_ADDRESS_HEADER=CloudFront-Viewer-Address

# ---- Tracing (optional) ----
# Leave the keys unset to run without tracing. To trace locally, start the
# `tracing` profile (docker compose --profile tracing up -d) and uncomment:
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_HOST=http://localhost:3000
# Local Langfuse login: admin@example.com / localdev
